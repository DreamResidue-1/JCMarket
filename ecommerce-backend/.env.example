GOOGLE_CLIENT_ID=your_google_web_client_id_here
# Optional comma-separated list when local/staging/production use different Google web client IDs.
# GOOGLE_CLIENT_IDS=client-id-1.apps.googleusercontent.com,client-id-2.apps.googleusercontent.com
JWT_SECRET=your_strong_jwt_secret_here
REFRESH_TOKEN_SECRET=your_strong_refresh_token_secret_here
ADMIN_EMAILS=admin@example.com
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175, https://jcmarket.onrender.com
PORT=3000

# Optional external database. If omitted, local development uses database.sqlite.
DB_TYPE=mysql
DB_HOST=sql.example.com
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
# DB_SSL=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# Optional. Leave empty to use SMTP_USER automatically (recommended for Gmail/Hostinger/cPanel SMTP).
SMTP_FROM="JCMarket <your_verified_sender@example.com>"
